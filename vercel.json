{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,

  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/carrusel",
      "destination": "/carrusel.html"
    },
    {
      "source": "/foto/:foto_id",
      "destination": "/detalle.html"
    }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],

  "functions": {
    "api/data.js": {
      "includeFiles": "generated/**",
      "maxDuration": 10
    },
    "api/image.js": {
      "includeFiles": "generated/**",
      "maxDuration": 60
    },
    "api/download.js": {
      "includeFiles": "generated/**",
      "maxDuration": 60
    },
    "api/qr.js": {
      "includeFiles": "generated/**",
      "maxDuration": 10
    }
  }
}