{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/carrusel",
      "destination": "/public/carrusel.html"
    },
    {
      "source": "/foto/:foto_id",
      "destination": "/public/detalle.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/public/assets/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/public/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/public/js/:path*"
    },
    {
      "source": "/fonts/:path*",
      "destination": "/public/fonts/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/data.js": {
      "runtime": "nodejs22.x",
      "includeFiles": "generated/**",
      "maxDuration": 10
    },
    "api/image.js": {
      "runtime": "nodejs22.x",
      "includeFiles": "generated/**",
      "maxDuration": 60
    },
    "api/download.js": {
      "runtime": "nodejs22.x",
      "includeFiles": "generated/**",
      "maxDuration": 60
    },
    "api/qr.js": {
      "runtime": "nodejs22.x",
      "includeFiles": "generated/**",
      "maxDuration": 10
    }
  }
}
